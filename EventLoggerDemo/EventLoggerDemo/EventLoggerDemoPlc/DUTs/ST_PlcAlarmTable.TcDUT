<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_PlcAlarmTable" Id="{76017cdc-33ab-4416-adf1-db06e191342c}">
    <Declaration><![CDATA[// Every alarm currently raised on this TwinCAT system, from any PLC or module.
TYPE ST_PlcAlarmTable :
STRUCT
    IsSubscribed : BOOL;
    Count        : UDINT;   // rows 0 to Count - 1 are in use, newest last
    Overflow     : BOOL;    // TRUE once an alarm could not be added because the table was full
    ChangeCount  : UDINT;   // rises when an alarm is added, confirmed or removed
    TextCount    : UDINT;   // rises when an alarm's text arrives
    Alarms       : ARRAY[0..GVL_EventLogging.MaxPlcAlarms - 1] OF ST_PlcAlarm;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>