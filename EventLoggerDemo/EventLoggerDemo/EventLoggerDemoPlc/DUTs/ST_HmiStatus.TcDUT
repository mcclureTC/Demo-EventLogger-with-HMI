<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_HmiStatus" Id="{b76a4a42-628d-48df-973b-3c8dedf75fcd}">
    <Declaration><![CDATA[// Read by the HMI.
TYPE ST_HmiStatus :
STRUCT
    Heartbeat             : UDINT;  // increments every cycle
    IsInitialised         : BOOL;   // all alarms and messages created in the EventLogger
    LastRequest           : E_HmiRequest;
    LastRequestAccepted   : BOOL;
    RequestCount          : UDINT;  // increments once per executed request
    OvenTemperature       : LREAL;
    OvenTemperatureLimit  : LREAL;
    OverTemperatureRaised : BOOL;
    LowAirPressureRaised  : BOOL;
    DriveFaultRaised      : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>