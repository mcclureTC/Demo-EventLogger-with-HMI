				<DisplayName TxtId=""><![CDATA[Supply air pressure is low ({0} mbar)]]></DisplayName>
				<DescriptionText TxtId=""><![CDATA[Raised and cleared from the HMI. No confirmation.]]></DescriptionText>
				<Severity>Warning</Severity>
				<Comment TxtId=""><![CDATA[Raised and cleared from the HMI. No confirmation.]]></Comment>
			</EventId>
			<EventId>
