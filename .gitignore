# =============================================================================
# TwinCAT EventLogger Demo
# Keeps build output, user settings and Beckhoff binaries out of the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / Visual Studio (Hmi/)
# -----------------------------------------------------------------------------
# Build output; NuGet packages are restored on build
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
publish/
*.nupkg
*.snupkg
packages/

# User-specific settings and IDE state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Local overrides that may hold machine-specific AMS Net IDs or routes
appsettings.Development.json
appsettings.*.local.json

# -----------------------------------------------------------------------------
# TwinCAT 3 (TwinCAT/ and any XAE solution created around it)
# -----------------------------------------------------------------------------
# Build and download output
_Boot/
_CompileInfo/
_Deployment/
*.compileinfo
*.bootinfo
LineIDs.dbg
LineIDs.dbg.bak

# Beckhoff libraries: referenced by placeholder, never committed
_Libraries/
*.library
*.compiled-library

# Archives that bundle compiled libraries
*.tpzip
*.tnzip
*.tszip

# Generated module descriptions; the event class file is source
*.tmc
!EventLoggerDemo.tmc

# XAE temporary, backup and per-user files
*.tmcRefac
*.~u
*.tsproj.bak
*.tsproj.orig
*.plcproj.bak
*.plcproj.orig
*.TcPOU.bak
*.project.~u
*.tpy

# Licence files: machine-bound trial or run-time licences
*.tclrs

# -----------------------------------------------------------------------------
# MQTT demo
# -----------------------------------------------------------------------------
# Certificates and private keys made by Tools/CertTool; regenerate them per PC
Broker/certs/
# Mosquitto's persistence file (retained messages)
Broker/data/
# Private keys and certificate files anywhere
*.key
*.pem
*.pem.key
*.pem.crt

# -----------------------------------------------------------------------------
# Operating system and editor clutter
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~